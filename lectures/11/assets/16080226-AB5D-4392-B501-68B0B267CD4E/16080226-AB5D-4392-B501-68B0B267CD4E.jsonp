ype":"texture","index":7,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":273,"height":240},"45C18F30748A985418E93F7D8F8C277E":{"type":"texture","index":53,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":830,"height":27},"2683270F4D5B91BD733C3D45D8D2600B":{"type":"texture","index":23,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":704,"height":27},"0D0BEB467EDDB5F1245B817D67BC658B":{"type":"texture","index":65,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":127,"height":27},"B0CBF492BC47072ABD490346B0EA2FCF":{"type":"texture","index":34,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":269.86819458007812,"height":230.31286621093747},"3EE2C458DF3ABE61EFCFE6F8C321C708":{"type":"texture","index":10,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":732,"height":27},"57AF4BE529D4AC901D4659F6DA13C54A":{"type":"texture","index":70,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":771,"height":27},"D473B44A519A903C29D86CFE53EC646F":{"type":"texture","index":20,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":796,"height":214},"460DA57AE190812A00D3BD1C3E27E440":{"type":"texture","index":25,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":800,"height":27},"CE0AFBD17A30EB2A82B88DCD1B5AB584":{"type":"texture","index":62,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":625,"height":27},"0BA848C94D4073ADA36A5CC1448B3469":{"type":"texture","index":36,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":700,"height":27},"C16259558C9E57C9E92519A0BE5187D3":{"type":"texture","index":46,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267CD4E.pdf"},"width":832,"height":27},"3AF153C9EFFDB0C72CF4F4F8FABFACC0":{"type":"texture","index":54,"url":{"native":"assets\/16080226-AB5D-4392-B501-68B0B267C