local_slide( {"name":"96197440-DFFB-4CDA-AB46-3117D531A557","json":{"assets":{"9F54661ADF76A5A00BE132105641AAA1":{"type":"texture","index":13,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":786,"height":59},"D536B79D0E8A902D0F3BCC98E773E777":{"type":"texture","index":1,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":837,"height":59},"F2FE28ADB9C2B2CBF2AA541A1D2A7972":{"type":"texture","index":51,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":827,"height":27},"8F34E9FF3778332420ACD816F6E3017B":{"type":"texture","index":60,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":131,"height":131},"6AE51F61D3EAC977BACCA2530852E01A":{"type":"texture","index":72,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":104,"height":22},"51944A304FA38CC73E5123AE9B89E3F2":{"type":"texture","index":50,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":600,"height":27},"A66D26FFDEC89C1A5608D7DB2006031A":{"type":"texture","index":46,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":802,"height":27},"33A76821B08439A146E3440F08EFFFEB":{"type":"texture","index":29,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":861,"height":27},"D3526C86D569FBDE5B60095DBBC98436":{"type":"texture","index":37,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":261,"height":222},"736C7D46D76DFA332BBA3769C2772426":{"type":"texture","index":42,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":738,"height":27},"846FBB4E91A40F9CBC999186EB8CF744":{"type":"texture","index":23,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":92,"height":27},"CACAE61485D698E705BDCF75258D9C38":{"type":"texture","index":7,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":273,"height":240},"45C18F30748A985418E93F7D8F8C277E":{"type":"texture","index":55,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":830,"height":27},"2683270F4D5B91BD733C3D45D8D2600B":{"type":"texture","index":26,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":704,"height":27},"954A2767C4176F25C7EEC33812666220":{"type":"texture","index":67,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":727,"height":27},"B0CBF492BC47072ABD490346B0EA2FCF":{"type":"texture","index":36,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":269.86819458007812,"height":230.31286621093747},"3EE2C458DF3ABE61EFCFE6F8C321C708":{"type":"texture","index":10,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":732,"height":27},"0430673F44B4E700C188E9AD99EEC54E":{"type":"texture","index":59,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":131,"height":131},"460DA57AE190812A00D3BD1C3E27E440":{"type":"texture","index":27,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":800,"height":27},"D3BF7DB42DAE90169107D3A1F917B23D":{"type":"texture","index":71,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":71,"height":27},"F9FB94D4734FA0605E25F29390572F8A":{"type":"texture","index":65,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":63,"height":21},"0BA848C94D4073ADA36A5CC1448B3469":{"type":"texture","index":38,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":700,"height":27},"C16259558C9E57C9E92519A0BE5187D3":{"type":"texture","index":48,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":832,"height":27},"3AF153C9EFFDB0C72CF4F4F8FABFACC0":{"type":"texture","index":56,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":797,"height":27},"DFA3C0641AE95DF43A09A208A0C031FC":{"type":"texture","index":53,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":174,"height":22},"1A637DD9366A33B15E6A4DDECCE91385":{"type":"texture","index":15,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":830,"height":59},"7ED88AC03385797130B20F09B1565395":{"type":"texture","index":5,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":888,"height":59},"F3398C009DB23105758E03359FB4404D":{"type":"texture","index":66,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":661,"height":27},"FBFD521FAEE8CA75D43094DC142F8F93":{"type":"texture","index":70,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":660,"height":27},"7C3006F11DCB5CEF1D02C72554D76DDD":{"type":"texture","index":45,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":702,"height":27},"B7B2377DDA86B6C916AA7D3FB62B8320":{"type":"texture","index":20,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":667,"height":54},"4BF80DD17D05D47149DEBC1D57278806":{"type":"texture","index":64,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":667,"height":27},"F4530A1D0AB34018D6DDF73EF5879257":{"type":"texture","index":34,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":754,"height":27},"9251636AE7EC24F2536617C9E7909BA3":{"type":"texture","index":0,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":1024,"height":768},"11A1B194A6B3E28265509DEB2111AE3D":{"type":"texture","index":40,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":514,"height":27},"2BD0B212A6B3AC67814C17E6853DD650":{"type":"texture","index":31,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":898,"height":27},"DCF45CDE4ECA1AE9707B6E81E63B764A":{"type":"texture","index":32,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":44,"height":20},"351782781F74E772E855523240534877":{"type":"texture","index":62,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":459,"height":27},"91013EE662AD0CC48937A5ADB5092937":{"type":"texture","index":2,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":882,"height":91},"1CF02C3504723048AB6AE4B09C1813CA":{"type":"texture","index":41,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":735,"height":27},"ED930B1168CC0CC607FF7C25835C1019":{"type":"texture","index":69,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":704,"height":27},"A00CE51C8468E82A83760A18DBF3B460":{"type":"texture","index":43,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":702,"height":27},"56F03BCD88803F343EF6B59D1AA5AFE0":{"type":"texture","index":24,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":835,"height":27},"9404D622465905C5AB9CDB9C04FEB758":{"type":"texture","index":44,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":813,"height":27},"3CEA8A9C7BCAED5C1D1BD501EA6B6B80":{"type":"texture","index":4,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":900,"height":123},"D823AA3CCD4CFFB483CFE997DF1D155C":{"type":"texture","index":73,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":634,"height":27},"A05342BDB577F5280D3E7544F7CF50C3":{"type":"texture","index":18,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":160,"height":173},"085DCEDC4526B4591A2A36405B0D56C1":{"type":"texture","index":57,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":156.04166078567505,"height":156.04166078567505},"2DFC06B8FC195C2FB29DC5A61809E6CE":{"type":"texture","index":16,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":161,"height":172},"CA4529F9015010B0D6EEE965B74B099D":{"type":"texture","index":75,"url":{"native":"assets\/96197440-DFFB-4CDA-AB46-3117D531A557.pdf"},"width":701,"height":27},"31E8B8D7FA