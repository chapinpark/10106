local_slide( {"name":"BD73D5CE-66C1-489F-8EC2-BDD9BCD75834","json":{"assets":{"07E97E656C14DB27D285FD16032198B1":{"type":"texture","index":22,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":784,"height":26},"19A2D14E9E879160B0155AD1FBF316F0":{"type":"texture","index":49,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":657,"height":435},"BE10307A94FA9434432C2D1EEC721FA5":{"type":"texture","index":13,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":802,"height":26},"179CFBB25AA23FB3CBBB185EB7520F58":{"type":"texture","index":16,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":678,"height":465},"9E5C1EFE71AFD382CBECA21884F0A5D7":{"type":"texture","index":54,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":725,"height":26},"7541200827C61B7DEA3603E5C499AE9A":{"type":"texture","index":31,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":830,"height":26},"60645B4BDAA015A2C528B6B0A2C779C1":{"type":"texture","index":4,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":199,"height":43},"99371E0FB9B086203BC386F2E934D2B0":{"type":"texture","index":3,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":793,"height":88},"E27934BB10ACE85095AC0FF210AA98E0":{"type":"texture","index":39,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":837,"height":28},"0A23D9EFD815B64F716A63E0FED54854":{"type":"texture","index":18,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":831,"height":115},"A0FC986E436C754378DD4A638C553FA0":{"type":"texture","index":56,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":804,"height":26},"C2587F5600EEEEFF46C9C3ED8B1F1BCD":{"type":"texture","index":35,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":840,"height":26},"31064B8ABC742F608E84158F6760B680":{"