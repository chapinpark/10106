75834.pdf"},"width":76,"height":21},"16D771AE31589A1537D4449E74EDC733":{"type":"texture","index":61,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":812,"height":26},"794B7F685A0D443EEDFB4443F2C19830":{"type":"texture","index":20,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":812,"height":150},"53766184380913D09E9915D7D017B312":{"type":"texture","index":44,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":674.34222221374512,"height":423.00002098083496},"3F083AC900FEFDC7C468EAD0D686A65C":{"type":"texture","index":37,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":452.64942932128906,"height":88.000002384185791},"CAC863172C50CBE9FFE01AE4837A9FAE":{"type":"texture","index":14,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":678,"height":436},"7E00A3F59BB4BDB4BC931A1F26CD748F":{"type":"texture","index":27,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":809,"height":26},"BE1B2CEF8B62ECB17294F21F05FA0DAD":{"type":"texture","index":55,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":824,"height":26},"68BCBD80456C5DF8D8A6AE05CC0A711F":{"type":"texture","index":42,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":185,"height":22},"720270DF2EE86C10F914E4AEDF5F4C0B":{"type":"texture","index":1,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":195,"height":43},"306A62A8834E358AC0ADB0DE7BF8402E":{"type":"texture","index":52,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":811,"height":26},"47B915BDD38C24BFBD0F39C873C3615E":{"type":"texture","index":17,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":518,"height":26},"4FFCA5CFDE39FBE239E565495E2EBBE6":{"type":"texture","index":38,"url":{"native":"assets\/BD73D5CE-66C1-489F-8EC2-BDD9BCD75834.pdf"},"width":428,"height":63},"1E4E4A913F7A75A5