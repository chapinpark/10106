local_slide( {"name":"26D03A54-60D8-4498-8787-AE524D8A3287","json":{"assets":{"B27EA69A1CC8A98804E249F6A8B44663":{"type":"texture","index":64,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":639,"height":27},"9D232A8E1BEFF4E246DB5C4D1056E3D2":{"type":"texture","index":17,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":324,"height":334},"C7FBD7C084EC6D9ABE2FBC660E9AC344":{"type":"texture","index":52,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":600,"height":27},"CB20848897B615E60F6D14E548B10CCC":{"type":"texture","index":65,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":632,"height":27},"854258D63CFFBEACD6E35389B8236F01":{"type":"texture","index":53,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":320,"height":322.39999294281006},"BD63C678795982B367C76D1F6C271B9D":{"type":"texture","index":43,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":535,"height":26},"0F17B3B07FC51AD7794C7D89B624662A":{"type":"texture","index":66,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":627,"height":29},"BA87168449292A6E1953031C557F3D23":{"type":"texture","index":46,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":814,"height":26},"7541200827C61B7DEA3603E5C499AE9A":{"type":"texture","index":32,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":830,"height":26},"F63C569F9AA1F3C509B802791F83F151":{"type":"texture","index":11,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":761,"height":26},"60645B4BDAA015A2C528B6B0A2C779C1":{"type":"texture","index":4,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":199,"height":43},"B47339E1F047BB07B4895F433B27D888":{"type":"texture","index":67,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":628,"height":27},"B2465A76A38C8C6D2B5C4C1D8389F25E":{"type":"texture","index":60,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":648,"height":29},"99371E0FB9B086203BC386F2E934D2B0":{"type":"texture","index":3,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":793,"height":88},"C3F890C70E644E0864787F04135C5332":{"type":"texture","index":13,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":804,"height":57},"3B5C4D83EA15460693ACC73DEAF79D6F":{"type":"texture","index":59,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":598,"height":27},"751AF9F585F077CBFAB62D20641B8F7F":{"type":"texture","index":9,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":814,"height":53},"1457F3263A2C73B417A0CFFEB9E6E36B":{"type":"texture","index":51,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":841,"height":27},"F23D2A3C9FAAB65FDA49F169419C26B3":{"type":"texture","index":68,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":299,"height":27},"10BEEAC5704954C8138BFEFEEF3B6025":{"type":"texture","index":57,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":303,"height":219},"6A7676D71B79256FC636C48A7A9D359B":{"type":"texture","index":48,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":812,"height":26},"995017347C0DDD74C46ADE65F505D332":{"type":"texture","index":14,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":830,"height":212},"DAF781154AD2639B284A94B6D5550ABD":{"type":"texture","index":47,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":825,"height":26},"32BB262C63CAC9BE30BE50F16B101DBE":{"type":"texture","index":8,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":690,"height":297},"6C1D736DB5C289A821C6CEE2A41DE91B":{"type":"texture","index":40,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":840,"height":26},"43EA6663B2190A902370969DC9F6EE97":{"type":"texture","index":24,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":442,"height":26},"974F923FE624D954FCC3E35B2D2C83AD":{"type":"texture","index":22,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":640,"height":155},"ADED8E4794DCF80DAA5391C3925A259E":{"type":"texture","index":19,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":324,"height":249},"ABE8C1FCB07B9F74FB0A4343738B2104":{"type":"texture","index":26,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":826,"height":26},"55B385E78FFFCAA0DE43207212AE0D10":{"type":"texture","index":39,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":813,"height":26},"3E0AE1069245B1CCE42F88E1C91E4DCC":{"type":"texture","index":33,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":686.02368354797363,"height":284.82772827148438},"440C54C0079989396BC8456746E78686":{"type":"texture","index":12,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":841,"height":88},"9D8457F5F9655BD676F313DDBF31FE8D":{"type":"texture","index":16,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":559,"height":27},"01C536CE2164A7ACC575570F5A70E891":{"type":"texture","index":58,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":459,"height":27},"6FE3FB070B2BA6B48F06FAAAF1995854":{"type":"texture","index":54,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":303,"height":306},"A6A8FE501278ED5E3B438CDCF6AB0495":{"type":"texture","index":29,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":719,"height":26},"9251636AE7EC24F2536617C9E7909BA3":{"type":"texture","index":0,"url":{"native":"assets\/26D03A54-60D8-4498-8787-AE524D8A3287.pdf"},"width":1024,"height":768},"6DF3B86E05EAB2910A0B0CA599518C9E":{"type":"texture","index":5