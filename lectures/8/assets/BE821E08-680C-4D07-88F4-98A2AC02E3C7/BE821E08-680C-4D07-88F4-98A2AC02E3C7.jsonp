ct":{"y":0,"x":0,"width":1,"height":1},"opacity":1,"edgeAntialiasingMask":0,"height":70,"hidden":false,"anchorPoint":{"pointX":0.50376521519252238,"pointY":0.5037754603794643}},"texture":"23B4856F5D58E1F884C8BA1CC01C2184"}]}]}}},"targetRectangle":{"y":691.30816650390625,"x":5.1952414512634277,"width":67.000001668930054,"height":67.000001668930054}}],"accessibility":[{"text":"Premise 5 says that this thing necessitates a future action of ours.","targetRectangle":{"y":486.3406982421875,"x":543.3509521484375,"width":450.52490234375,"height":64}},{"text":"2. In the past, God had foreknowledge of our future actions.","targetRectangle":{"y":127.08657073974609,"x":71.289627075195312,"width":367.431640625,"height":80.600000739097595}},{"text":"But now focus on premises 3, 4, and 5. ","targetRectangle":{"y":461.041259765625,"x":43.048662185668945,"width":419.10400390625,"height":32}},{"text":"5. God knowing that we will perform some action necessitates that we will perform that action.","targetRectangle":{"y":315.63876342773438,"x":617.75677490234375,"width":367.431640625,"height":105.40000110864639}},{"text":"two arguments against free will","targetRectangle":{"y":698.5455322265625,"x":162.83050530992347,"width":51.58203125,"height":52}},{"text":"is fate real?","targetRectangle":{"y":707.5455322265625,"x":96.294616807716096,"width":37.3876953125,"height":34}},{"text":"3. We have no choice about God’s knowing that in \\u2028    the future I will perform a certain action. (1,2)","targetRectangle":{"y":281.66390991210938,"x":143.51344299316406,"width":393.6767578125,"height":105.40000110864639}},{"text":"Premise 3 mentions something that we have no choice about. ","targetRectangle":{"y":531.7620849609375,"x":64.888320922851562,"width":415.0634765625,"height":64}},{"text":"1. We have no choice about past facts.","targetRectangle":{"y":23.834905624389648,"x":321.40032958984375,"width":354.30908203125,"height":55.800000369548798}},{"text":"three ways out","targetRectangle":{"y":7