1},"30583860ED64FB75C62B3A5AD7BD154E":{"type":"texture","index":70,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":442,"height":26},"C7CFCA72AF3FC9F0BC1564E792B876FF":{"type":"texture","index":58,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":796,"height":29},"5232554ED51E7845D66EA762EEDA9762":{"type":"texture","index":77,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":772,"height":26},"413DEA0D8E48368140D3348E636E8D73":{"type":"texture","index":41,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":794,"height":29},"F04EB7E1B5EDFBA43E5F7926EE0006F4":{"type":"texture","index":22,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":782,"height":181},"24B9DA7DA4849E801F3D47CF15D68371":{"type":"texture","index":14,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":798,"height":63},"94959A9B5400D3553D473D0A0399C3A2":{"type":"texture","index":52,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":774,"height":31},"6CC50418E47D231D6101504970255589":{"type":"texture","index":61,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":133,"height":24},"670E2C94D25CC432ED98163C63D8A9DE":{"type":"texture","index":8,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":645,"height":24},"2087DE4B12CCE5B3DC3BC83D771D01B9":{"type":"texture","index":53,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":349,"height":29},"9251636AE7EC24F2536617C9E7909BA3":{"type":"texture","index":0,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":1024,"height":768},"03A3842AD242B9A5DAB380B7B6B82BE0":{"type":"texture","index":73,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4-44FE3FC37EAF.pdf"},"width":764,"height":26},"0621D91E727D65F68D3BCDFCF6B1AC72":{"type":"texture","index":33,"url":{"native":"assets\/C2539F5D-F352-43FC-95D4