local_slide( {"name":"26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7","json":{"assets":{"734370C39FBC60BD42FAE4C2F250759F":{"type":"texture","index":46,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":365,"height":27},"43DE8E1644567A2D8F82F7CBDB1E2BB7":{"type":"texture","index":69,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":454,"height":27},"E6580929A825B5DA6DD191DA9E75A134":{"type":"texture","index":17,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":828,"height":91},"6F157CF7382E96102C10E03D91EBA06A":{"type":"texture","index":9,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":735,"height":59},"3ECA597AA22292CC5B0A7B19E76F9A7E":{"type":"texture","index":36,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":554,"height":27},"FD7089A27AF6B08D1CF40ADF21CCDDD0":{"type":"texture","index":53,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":638,"height":27},"0600FFABFE8A642E24B3EAC5DD3A8491":{"type":"texture","index":8,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":568,"height":127},"5039C6D154A6B4674298882A8F9B3AD3":{"type":"texture","index":3,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":235,"height":235},"9B7C9404332AAAFC41D479C4B3660EE7":{"type":"texture","index":2,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":235,"height":235},"73122D1064A99C9298F1FFC1C3B4B9A2":{"type":"texture","index":55,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":822,"height":502},"C4016A72D36B3EA404E1CFB356BA3067":{"type":"texture","index":20,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":810,"height":27},"96E518B25C671EAF76DDF39A48292E82":{"type":"texture","index":37,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":824,"height":27},"77CD09F3C54413903BFCD788F284B9F9":{"type":"texture","index":29,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":778,"height":27},"370B71DD78061FC1DB6FC5D93246B107":{"type":"texture","index":35,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":815,"height":27},"6018D5F99ABF5FF26114B24EBA4A9766":{"type":"texture","index":39,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":795,"height":27},"C0DF8705B330EDB70991372A5FDD858F":{"type":"texture","index":25,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":631,"height":27},"9581E1428183AD3AD46BDD8120F6D283":{"type":"texture","index":15,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":778,"height":59},"A7C1388504A2045B703C32B3E78D31F5":{"type":"texture","index":33,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":817,"height":27},"9B5F70F083A73C5A9C717C663923A430":{"type":"texture","index":43,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":809,"height":27},"7BDCCB321618ACF9CD7736777DEBAD8F":{"type":"texture","index":30,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":679,"height":27},"5591113CDFF4F55F6490FDC4FE7BB6E0":{"type":"texture","index":19,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":822,"height":502},"E980DB46D903DE3BB6BAFC7DB29C5C82":{"type":"texture","index":65,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":154,"height":24},"A362EFE7D84A7E2AD5D86FB8FB2AE39B":{"type":"texture","index":51,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":819,"height":27},"451F1EE2AF5C7C04D7368B019B68372F":{"type":"texture","index":10,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":818,"height":91},"A7E44F8440E8A6C1E7AF50316803B442":{"type":"texture","index":54,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":886,"height":27},"42BB33B7B1312269CC48EBF8674C749B":{"type":"texture","index":56,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":723,"height":26},"6C2E1858CD6F653681F4B2405349BCB7":{"type":"texture","index":13,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":798,"height":91},"19FFFB2885BC1A27A21EC3FB611AF156":{"type":"texture","index":26,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":827,"height":27},"6559ED475F78739B944C0BC8661E1C27":{"type":"texture","index":41,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":572,"height":27},"9A525A34FABE63BAC99FC77481CA6929":{"type":"texture","index":62,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":752,"height":27},"516AB611AA7A6E46630507727BE27457":{"type":"texture","index":12,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":824,"height":59},"6490DDCB41B75D438C015C1B7F25667E":{"type":"texture","index":21,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":788,"height":27},"410221B1A52CB83DCD8CBD6E828B40B5":{"type":"texture","index":57,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":729,"height":26},"D906FC9E628A72BEBC49A9C750686507":{"type":"texture","index":66,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":663,"height":26},"8038287CF764FEEC0FD0FC214B0FEE36":{"type":"texture","index":31,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":734,"height":27},"9251636AE7EC24F2536617C9E7909BA3":{"type":"texture","index":0,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":1024,"height":768},"8231E7413BB91D95ECEA6466AAD0E024":{"type":"texture","index":67,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA05-47CD21AF7BB7.pdf"},"width":721,"height":26},"2F3562ABDBE7CF86A329CC83A9C18F47":{"type":"texture","index":47,"url":{"native":"assets\/26F6B5F1-FD3F-49A4-AA0