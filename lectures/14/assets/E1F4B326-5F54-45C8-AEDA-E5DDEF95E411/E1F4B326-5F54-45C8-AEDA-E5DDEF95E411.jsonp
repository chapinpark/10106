2047348027,"width":13.900000000000091,"height":34}},{"text":"150 IQ ","targetRectangle":{"y":444.74765014648438,"x":-723.5570167064667,"width":83.050000000000068,"height":34}},{"text":"machine","targetRectangle":{"y":478.74765014648438,"x":-732.51951670646667,"width":94.024999999999977,"height":34}},{"text":"Mindful of Caleb’s fate, Emily decides to take a different path. Like Caleb, she lacks the patience for gradual uploading. But she wants to become a synthetic thing, and knows that Caleb failed to achieve this. ","targetRectangle":{"y":71.381019592285156,"x":137.43661499023438,"width":786.4990234375,"height":96}},{"text":"2 ","targetRectangle":{"y":629.41949462890625,"x":-342.66911561489104,"width":20.849999999999966,"height":34}},{"text":"years","targetRectangle":{"y":663.41949462890625,"x":-364.65661561489105,"width":57.875,"height":34}},{"text":"165 IQ ","targetRectangle":{"y":434.05715942382812,"x":-373.76911387443545,"width":83.050000000000011,"height":34}},{"text":"machine","targetRectangle":{"y":468.05715942382812,"x":-382.73161387443542,"width":94.024999999999977,"height":34}},{"text":"You can survive slow gradual destructive uploading.","targetRectangle":{"y":-479.37496948242188,"x":261.06462097167969,"width":170.59326171875,"height":130.20000147819519}},{"text":"Let’s look at one last example.","targetRectangle":{"y":21.356283187866211,"x":348.63252258300781,"width":321.1181640625,"height":32}},{"text":"If you can survive slow gradual destructive uploading, you can survive fast gradual destructive uploading.","targetRectangle":{"y":-448.20114135742188,"x":570.87107849121094,"width":301.81884765625,"height":155.00000184774399}},{"text":"You cannot survive instant non-destructive uploading.","targetRectangle":{"y":607.40997314453125,"x":1075.7715454101562,"width":164.031982421875,"height":130.20000147819519}}],"baseLayer":{"animations":[],"initialState":{"affineTransform":[1,0,0,1,0,0],"masksToBounds":false,"rotation":0,"scale":1,"position":{"pointX":512