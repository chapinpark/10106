tY":0.5}},"texture":"4FC4D061B0D3CC71F92DC70EB84AB2ED"}]}]},"effects":[],"duration":0.001,"type":"buildIn","attributes":{"direction":0},"name":"apple:bc-appear","objectID":"7F6D004F-AB2F-4EC2-9F70-9BAE18DEF0C5"}],"automaticPlay":false,"hyperlinks":[],"accessibility":[{"text":"Intuitively, the idea is that your epistemic peer is just as likely to give the correct answer to some question as you are. So, if an epistemic peer disagrees with you, you should reduce your confidence in your own belief.","targetRectangle":{"y":444.48629760742188,"x":131.37647247314453,"width":751.65234375,"height":84}},{"text":"These are simple cases of disagreement. Many people have the intuition that, in cases like these, disagreement should lead us to revise our beliefs. ","targetRectangle":{"y":93.936569213867188,"x":151.82763671875,"width":743.66015625,"height":56}},{"text":"Whenever someone has as many of the qualities which are relevant to correctly answering some question as you do, we will say that that person is your epistemic peer. ","targetRectangle":{"y":323.63638305664062,"x":131.63524627685547,"width":768.796875,"height":90}},{"text":"The restriction to disagreement among epistemic peers is important to keep in mind when one learns how many people believe in astrology, believe that global warming is a hoax, etc. ","targetRectangle":{"y":576.33620463349507,"x":146.80858993530273,"width":737.6982421875,"height":84}},{"text":"Of course, we are making some background assumptions about these cases. For example, in the case of the horse race we are assuming that the other person has as good of eyesight as you do. And in the splitting the bill case we are assuming that your friends are not terrible at math. ","targetRectangle":{"y":180.78648376464844,"x":133.7001953125,"width":779.9150390625,"height":112}}],"baseLayer":{"animations":[],"initialState":{"affineTransform":[1,0,0,1,0,0],"masksToBounds":false,"rotation":0,"scale":1,"position":{"pointX":512,"pointY":384},"width":1024,"subl