}]}}},"targetRectangle":{"y":196.60308837890625,"x":32.587043762207031,"width":60.000002384185791,"height":60.000002384185791}}],"accessibility":[{"text":"Here are some examples of contingent facts.","targetRectangle":{"y":395.40292358398438,"x":305.64278411865234,"width":462.59765625,"height":32}},{"text":"You are a student at Notre Dame.","targetRectangle":{"y":628.28436279296875,"x":335.83381652832031,"width":339.732421875,"height":72}},{"text":"Once you understand what possible and necessary mean, you can understand what it takes for a state of affairs or thing to be contingent.","targetRectangle":{"y":214.12594604492188,"x":167.85990905761719,"width":763.43994140625,"height":66.1484375}},{"text":"Most of the earth is covered in water.","targetRectangle":{"y":479.73703002929688,"x":135.71162414550781,"width":352.583984375,"height":72}},{"text":"possible","targetRectangle":{"y":92.841629028320312,"x":281.31338500976562,"width":68.90625,"height":25}},{"text":"Leibniz’s argument","targetRectangle":{"y":140.07279968261719,"x":42.958138338642726,"width":40.913085823141188,"height":26}},{"text":"necessary","targetRectangle":{"y":91.203754425048828,"x":496.01876831054688,"width":81.845703125,"height":25}},{"text":"contingent","targetRectangle":{"y":85.7037353515625,"x":709.1234130859375,"width":128.064453125,"height":36}},{"text":"the","targetRectangle":{"y":37.042510986328125,"x":51.356086615449932,"width":22.461914062499993,"height":21}},{"text":"PSR","targetRectangle":{"y":58.042510986328125,"x":46.952519857694085,"width":31.26904296875,"height":21}},{"text":"Notre Dame is in Indiana.","targetRectangle":{"y":499.23703002929688,"x":605.25579833984375,"width":319.51171875,"height":36}},{"text":"A state of affairs is contingent just in case (i) it actually is the case, and (ii) it is not necessary (that is, it is possible that it not be the case).","targetRectangle":{"y":304.76443481445312,"x":182.00834655761719,"width":767.4560546875,"height":64}},{"text":"objections 