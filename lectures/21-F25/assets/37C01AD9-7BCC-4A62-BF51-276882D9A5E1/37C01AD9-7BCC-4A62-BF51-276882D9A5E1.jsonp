.59999465942383},"BF1003C2BE1376C7CC1BD2E38B4CF84F":{"type":"texture","index":35,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":226,"height":191},"BBC8CA5AE56FF0D19F3E4236EB237CB2":{"type":"texture","index":127,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":246.72635930776596,"height":178.19999599456787},"FEAE55FD5E8ACC7335B727F6E8EB4D41":{"type":"texture","index":90,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":180,"height":149},"C2A2860E7017036F7CDA2EF33B32699E":{"type":"texture","index":81,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":600,"height":27},"8C851D27F5812FFA154B4EDCDB5B735C":{"type":"texture","index":105,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":246.72635930776596,"height":178.19999599456787},"BE004253695D3DFA01BF13A77FCDC6A4":{"type":"texture","index":41,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":866,"height":27},"79ECACB7C9E17D5B8029C713B4E6A71D":{"type":"texture","index":11,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":602,"height":59},"070FAAE5124BFBAEF74614320F7068EF":{"type":"texture","index":55,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":697,"height":236},"4378D6996BD874E0336A9E3566BBFAB2":{"type":"texture","index":71,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":480,"height":27},"4A8AB546BEC453DDF6D5535D18A18AF1":{"type":"texture","index":119,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":290,"height":27},"E6A57DD8E40997543CABB88347DF691E":{"type":"texture","index":139,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":479,"height":27},"F2FD69475253B6AE57A26A252D4323FC":{"type":"texture","index":95,"url":{"native":"assets\/37C01AD9-7BCC-4A62-BF51-276882D9A5E1.pdf"},"width":631,"height":27},"5FA22F75E1CC59F430FD90E22EDCC