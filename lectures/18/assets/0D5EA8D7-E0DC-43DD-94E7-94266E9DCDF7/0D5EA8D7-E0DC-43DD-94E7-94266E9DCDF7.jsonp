orPoint":{"pointX":0.50032982971990991,"pointY":-0.091170310974121094}},"texture":"520D1DE72EC60D8D98D3DCC63C6E433F"}]}]},"effects":[],"duration":0.5,"type":"transition","attributes":{"direction":0},"name":"apple:magic-move-implied-motion-path","objectID":"0"}],"automaticPlay":false,"hyperlinks":[{"url":"?slideid=959D1298-A5B8-4C24-B5BE-E1ED3C341D2E","targetRectangle":{"y":19.318078994750977,"x":25.651723861694336,"width":140,"height":136.75924682617188}},{"url":"?slideid=D5F57A21-524A-45A1-A29A-A3AB23DA7A28","targetRectangle":{"y":90.200004577636719,"x":185.56163024902344,"width":50,"height":48.84259033203125}},{"url":"?slideid=B2C62295-F05C-469C-9747-5B869207F385","targetRectangle":{"y":29.134250640869141,"x":185.56163024902344,"width":50,"height":49.074073791503906}}],"accessibility":[{"text":"A second challenge comes from the Good-Motivation Connection:","targetRectangle":{"y":48.406108856201172,"x":292.35223388671875,"width":687.59765625,"height":32}},{"text":"The Good-Motivation Connection","targetRectangle":{"y":146.42957305908203,"x":450.06707763671875,"width":372.16796875,"height":32}},{"text":"If someone sincerely judges that X is good, they must have some motivation to pursue X.","targetRectangle":{"y":175.22957229614258,"x":408.15423583984375,"width":464.306640625,"height":89.599998474121094}},{"text":"pasted-image.pdf","targetRectangle":{"y":19.318078994750977,"x":25.651723861694336,"width":140,"height":136.75924682617188}},{"text":"If when we say that something is good we are simply asserting that it has a certain property — as the moral realist thinks — why should that have to be connected to motivation in any way? Does goodness have some magical property which is impossible to resist? Or should the moral realist deny that the above principle is true?","targetRectangle":{"y":330.85302734375,"x":272.91864013671875,"width":734.77783203125,"height":160}},{"text":"pasted-image.pdf","targetRectangle":{"y":90.200004577636719,"x":185.56163024902344,"width":5