:29.134250640869141,"x":185.56163024902344,"width":50,"height":49.074073791503906}},{"url":"?slideid=959D1298-A5B8-4C24-B5BE-E1ED3C341D2E","targetRectangle":{"y":94.230827331542969,"x":185.56163024902344,"width":50,"height":48.84259033203125}},{"url":"?slideid=D5F57A21-524A-45A1-A29A-A3AB23DA7A28","targetRectangle":{"y":21.049774169921875,"x":27.092348098754883,"width":139.32150268554688,"height":136.09646606445312}}],"accessibility":[{"text":"pasted-image.pdf","targetRectangle":{"y":29.134250640869141,"x":185.56163024902344,"width":50,"height":49.074073791503906}},{"text":"pasted-image.pdf","targetRectangle":{"y":94.230827331542969,"x":185.56163024902344,"width":50,"height":48.84259033203125}},{"text":"Is abortion ever morally permissible?","targetRectangle":{"y":336.17275309562683,"x":675.43391418457031,"width":241.455078125,"height":55.800000369548798}},{"text":"Let’s focus on this third, relativist option first.","targetRectangle":{"y":127.07276916503906,"x":347.57559204101562,"width":483.94775390625,"height":32}},{"text":"Are middle-class people morally obliged to give money to the poor?","targetRectangle":{"y":323.77275228500366,"x":221.65031433105469,"width":291.24609375,"height":80.600000739097595}},{"text":"Moral relativism is, it seems, a very widely held view. Suppose that you are asked some controversial ethical question, like","targetRectangle":{"y":211.57275390625,"x":174.86294555664062,"width":793.02978515625,"height":64}},{"text":"“For me this is wrong, but that does not mean that it is wrong for everyone.”","targetRectangle":{"y":535.85163640975952,"x":78.439128875732422,"width":253.52783203125,"height":105.40000110864639}},{"text":"Many people would respond to at least some questions of this sort — even if not the examples above — by saying something like:","targetRectangle":{"y":442.1666567325592,"x":128.055908203125,"width":856.201171875,"height":64}},{"text":"pasted-image.pdf","targetRectangle":{"y":21.049774169921875,"x":27.092348098754883,"wid