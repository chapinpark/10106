irection":0},"name":"apple:bc-appear","objectID":"ABBB17B1-6C55-4BAC-8CF2-68753671C508"}],"automaticPlay":false,"hyperlinks":[],"accessibility":[{"text":"soul","targetRectangle":{"y":-223.19622802734375,"x":240.48544490116998,"width":35.742187500000028,"height":28}},{"text":"survival","targetRectangle":{"y":-195.19622802734375,"x":224.46982004659165,"width":67.773437499999972,"height":28}},{"text":"M + P + S ","targetRectangle":{"y":-209.04000854492188,"x":752.74267843155667,"width":110.85498046875,"height":27}},{"text":"Last time we discussed some reasons to think that we should not believe in the existence of immaterial souls unless we have a good argument that they exist.","targetRectangle":{"y":32.069341659545898,"x":181.349609375,"width":669.28125,"height":93}},{"text":"Our topic today is the class of answers to the survival question which make reference to immaterial souls. There were four of these:","targetRectangle":{"y":-412.778076171875,"x":222.787109375,"width":586.40625,"height":93}},{"text":"P","targetRectangle":{"y":-237.55560302734375,"x":607.44525148817752,"width":14.052734375,"height":28}},{"text":"+","targetRectangle":{"y":-209.55560302734375,"x":605.92181657475282,"width":17.099609375,"height":28}},{"text":"S ","targetRectangle":{"y":-181.55560302734375,"x":608.36322032794146,"width":19.55078125,"height":28}},{"text":"These theories are importantly different. But they have one thing in common: all are false if there are no such things as immaterial souls. ","targetRectangle":{"y":-70.760246276855469,"x":167.427734375,"width":697.125,"height":62}},{"text":"M","targetRectangle":{"y":-237.61810302734375,"x":428.52276612624445,"width":19.55078125,"height":28}},{"text":"+","targetRectangle":{"y":-209.61810302734375,"x":429.74835465579361,"width":17.099609375,"height":28}},{"text":"S ","targetRectangle":{"y":-181.61810302734375,"x":432.18975842350426,"width":19.55078125,"height":28}}],"baseLayer":{"animations":[],"initialState":{"affineTransform":[1,0,0