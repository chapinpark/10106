252,"height":25},"89E3F0FB1BAFC59A5E01010C9D89EE9E":{"type":"texture","index":70,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":659,"height":27},"3CEF91A3E174043E170B989278ABA06C":{"type":"texture","index":140,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":309,"height":245},"6DB3D2BED945385BBA22B2076730E35E":{"type":"texture","index":105,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":509,"height":26},"87D8E0F0268F3B45B18204252458D762":{"type":"texture","index":65,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":659,"height":27},"5F8DCD700AE0908A670790B5CD54F117":{"type":"texture","index":50,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":582,"height":27},"C92B2EFB96478D68B2E1A5E074024A76":{"type":"texture","index":146,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":275,"height":23},"3059A95AD041FF1058792FEDBC396DE1":{"type":"texture","index":110,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":460,"height":26},"2D90F43D65069D4AAA91F1A1154DCDA6":{"type":"texture","index":80,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":355,"height":23},"8B102C60D939892F03AEB027ABF4DBF8":{"type":"texture","index":53,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":585,"height":27},"40306D18BA45A20001A26B49A9BB5F73":{"type":"texture","index":4,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":178,"height":175},"4BDD3DA276C67539F8E7CEE22AE8DEFB":{"type":"texture","index":16,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":672,"height":59},"68F04ED7D4DA85BB974BDFFD964F03EC":{"type":"texture","index":131,"url":{"native":"assets\/8E746F8B-F99B-4700-A343-08D740598CD1.pdf"},"width":310,"height":245},"3E62C9EE13CA9073658D1C1C6803B74D":{"type":"texture","index":76,"url":{"native":"assets\/8E7